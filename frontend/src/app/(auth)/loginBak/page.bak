/* eslint-disable @typescript-eslint/no-unused-vars */
/* eslint-disable @typescript-eslint/no-explicit-any */
'use client';

import { useState, useEffect, Suspense } from 'react';
import { useRouter } from 'next/navigation';
import { Loader2, ShieldCheck } from 'lucide-react';
import { toast } from 'sonner';
// ✅ Remplacement du vieux provider par le nouveau store Zustand (Architecture Souveraine)
import { useAuthStore } from '@/store/authStore';

function LoginContent() {
  const router = useRouter();
  
  // ✅ Utilisation du nouveau store Zustand
  const { isAuthenticated, setLogin } = useAuthStore();
  
  const [hasMounted, setHasMounted] = useState(false);
  const [mode, setMode] = useState<'LOADING' | 'CHOICE' | 'LOGIN_FORM'>('LOADING');
  const [form, setForm] = useState({ email: '', password: '', tenantId: '' });
  const [isLoading, setIsLoading] = useState(false);

  // Sécurité d'hydratation (évite les erreurs de rendu serveur/client)
  useEffect(() => {
    setHasMounted(true);
  }, []);

  // Redirection automatique si déjà connecté
  useEffect(() => {
    if (hasMounted && isAuthenticated) {
      const slug = window.location.hostname.split('.')[0].toLowerCase();
      router.push(slug === 'matrix' || slug === 'elite' ? '/admin/matrix' : '/dashboard');
    }
  }, [hasMounted, isAuthenticated, router]);

  // Détection du domaine
  useEffect(() => {
    const initMatrix = async () => {
      try {
        const res = await fetch('/api/public/tenants');
        if (!res.ok) throw new Error("Erreur de liaison API");
        const tenants = await res.json();
        const slug = window.location.hostname.split('.')[0].toLowerCase();

        const match = tenants.find((t: any) => t.T_Domain.split('.')[0].toLowerCase() === slug);
        
        if (slug === 'matrix' || slug === 'elite' || slug === 'admin') {
          setForm(f => ({ ...f, tenantId: 'MATRIX' }));
          setMode('LOGIN_FORM');
        } else if (match) {
          setForm(f => ({ ...f, tenantId: match.T_Id }));
          setMode('LOGIN_FORM');
        } else {
          setMode('CHOICE');
        }
      } catch { 
        setMode('CHOICE'); 
      }
    };
    initMatrix();
  }, []);

  const handleAuth = async (e: React.FormEvent) => {
    e.preventDefault();
    setIsLoading(true);
    
    try {
      const res = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(form),
      });

      if (!res.ok) throw new Error('Accès refusé');
      
      const data = await res.json();
      
      // 1. Sauvegarde du token dans le cookie pour le Middleware
      document.cookie = `qualisoft_token=${data.accessToken}; path=/; max-age=28800; Secure; SameSite=Lax`;
      
      // 2. Hydratation du Store Zustand global
      setLogin({ token: data.accessToken, user: data.user });
      
      // 3. Redirection finale
      window.location.href = data.user.tenantDomain ? `https://${data.user.tenantDomain}.qualisoft.sn/dashboard` : '/dashboard';
      
    } catch (err: any) {
      toast.error("Identifiants incorrects ou accès refusé.");
    } finally { 
      setIsLoading(false); 
    }
  };

  if (!hasMounted || mode === 'LOADING') {
    return (
      <div className="flex justify-center items-center h-full">
        <Loader2 className="animate-spin text-blue-600 h-10 w-10" />
      </div>
    );
  }

  return (
    <div className="w-full max-w-md bg-slate-900/40 border border-white/5 rounded-[3rem] p-10 backdrop-blur-xl animate-in fade-in zoom-in duration-300">
       <div className="text-center mb-8">
         <ShieldCheck size={40} className="text-blue-500 mx-auto mb-4" />
         <h1 className="text-xl font-black text-white uppercase tracking-wider">Autorisation Requise</h1>
       </div>
       
       <form onSubmit={handleAuth} className="space-y-5">
          <input 
            required 
            type="email" 
            value={form.email} 
            onChange={e => setForm({...form, email: e.target.value})} 
            className="w-full p-4 bg-black/20 border border-white/10 rounded-xl text-white outline-none focus:border-blue-500 transition-colors" 
            placeholder="COURRIEL" 
          />
          <input 
            required 
            type="password" 
            value={form.password} 
            onChange={e => setForm({...form, password: e.target.value})} 
            className="w-full p-4 bg-black/20 border border-white/10 rounded-xl text-white outline-none focus:border-blue-500 transition-colors" 
            placeholder="CODE D'ACCÈS" 
          />
          <button 
            disabled={isLoading}
            type="submit" 
            className="w-full py-4 bg-blue-600 rounded-xl font-black text-white hover:bg-blue-500 transition-all flex justify-center items-center gap-2"
          >
            {isLoading ? <Loader2 className="animate-spin" /> : "CONNEXION AU NOYAU"}
          </button>
       </form>
    </div>
  );
}

export default function LoginPage() {
  return (
    <div className="min-h-screen bg-[#0B0F1A] flex items-center justify-center p-4">
      <Suspense fallback={<Loader2 className="animate-spin text-blue-600 h-10 w-10" />}>
        <LoginContent />
      </Suspense>
    </div>
  );
}